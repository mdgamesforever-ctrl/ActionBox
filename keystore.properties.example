# Template for the release-signing credentials app/build.gradle.kts reads.
#
# 1. Copy this file to keystore.properties (same directory) — that filename is gitignored and
#    must never be committed.
# 2. Fill in the real values below, pointing at your actual .jks keystore file.
#
# storeFile can be an absolute path or relative to the project root (ActionBox/).
storeFile=actionbox-release.jks
storePassword=CHANGE_ME
keyAlias=actionbox
keyPassword=CHANGE_ME

# CI (see .github/workflows/release.yml) does not use this file at all -- it supplies the same
# four values as the RELEASE_STORE_FILE / RELEASE_STORE_PASSWORD / RELEASE_KEY_ALIAS /
# RELEASE_KEY_PASSWORD environment variables instead, sourced from GitHub Actions secrets.
