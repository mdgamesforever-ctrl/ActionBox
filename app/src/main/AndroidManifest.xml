<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required on API 33+ to post the daily digest / WAITING follow-up notifications
         (reminders/DigestWorker.kt, reminders/WaitingNudgeWorker.kt). Requested at runtime
         when the user enables the digest toggle in Settings — see SettingsScreen.kt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Needed for AdMob (free-tier banner ads) and Play Billing (the Pro subscription) to
         reach Google's servers — the only network traffic this app makes; see the onboarding
         screen copy, which should be read alongside this as "your captured notification
         content never leaves the device," not "the app makes no network calls at all". -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ActionBoxApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ActionBox">

        <!-- The real App ID in release builds, Google's published TEST App ID in debug builds
             (see app/build.gradle.kts's admobAppId manifest placeholder, set per build type) —
             debug builds must never request real ads (AdMob policy: real ad requests from a
             developer's own test device/build are invalid traffic). ui/ads/BannerAdView.kt's
             ad unit ID follows the same debug/release split via BuildConfig. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ActionBox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.CapturedNotificationListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".service.BootCompletedReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Home screen widget (Pro-exclusive) — see widget/ActionBoxWidget.kt.
             DISABLED for the v1 release: an extensive investigation (dependency-graph
             bisection, first-party source bisection down to a single file, dex/method-count
             experiments) diagnosed a "Couldn't add widget" launcher-side RemoteViews
             inflation failure without finding a fix, and it wasn't worth blocking launch
             over. The receiver is commented out here (not deleted) specifically so the
             widget can't be discovered or added via the OS widget picker in this build,
             while ActionBoxWidget.kt/ActionBoxWidgetReceiver.kt/actionbox_widget_info.xml
             stay in the codebase to revisit post-launch — re-enable by uncommenting this
             block.
        <receiver
            android:name=".widget.ActionBoxWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/actionbox_widget_info" />
        </receiver>
        -->

    </application>

</manifest>
