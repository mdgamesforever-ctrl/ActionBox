    <string name="app_name">ActionBox</string>

    <string name="onboarding_title">ActionBox को अपनी सूचनाएँ पढ़ने की अनुमति दें</string>
    <string name="onboarding_body">ActionBox आने वाली सूचनाओं (जैसे WhatsApp संदेश, SMS और ईमेल) को कार्रवाई योग्य आइटम में व्यवस्थित करता है। इसके लिए, इसे सूचना सामग्री पढ़ने की अनुमति चाहिए।\n\nआपकी सूचनाओं की सामग्री इसी डिवाइस पर रहती है और कहीं भी अपलोड नहीं होती — वर्गीकरण पूरी तरह से डिवाइस पर ही होता है। (मुफ़्त योजना विज्ञापन दिखाती है, और Pro खरीदारी Google Play के माध्यम से होती है; इनमें से कोई भी आपकी सूचना सामग्री नहीं देखता।) आप सिस्टम सेटिंग्स से कभी भी सूचना एक्सेस रद्द कर सकते हैं।</string>
    <string name="onboarding_grant_button">सूचना एक्सेस सेटिंग्स खोलें</string>
    <string name="onboarding_status_granted">सूचना एक्सेस दे दिया गया है। ActionBox सूचनाएँ कैप्चर कर रहा है।</string>
    <string name="onboarding_status_not_granted">सूचना एक्सेस अभी तक नहीं दिया गया है।</string>

    <string name="feed_title">कैप्चर की गई सूचनाएँ</string>
    <string name="feed_empty">अभी तक कोई सूचना कैप्चर नहीं हुई। इसे यहाँ दिखने के लिए किसी अन्य ऐप (WhatsApp, SMS, Gmail, आदि) से एक सूचना भेजें।</string>

