    <string name="app_name">ActionBox</string>

    <string name="onboarding_title">Izinkan ActionBox membaca notifikasimu</string>
    <string name="onboarding_body">ActionBox mengatur notifikasi masuk (seperti pesan WhatsApp, SMS, dan email) menjadi item yang dapat ditindaklanjuti. Untuk melakukannya, aplikasi ini memerlukan izin untuk membaca konten notifikasi.\n\nKonten notifikasimu tetap berada di perangkat ini dan tidak pernah diunggah ke mana pun — klasifikasi sepenuhnya berjalan di perangkat. (Paket gratis menampilkan iklan, dan pembelian Pro dilakukan melalui Google Play; keduanya tidak pernah melihat konten notifikasimu.) Kamu dapat mencabut akses notifikasi kapan saja dari pengaturan sistem.</string>
    <string name="onboarding_grant_button">Buka Pengaturan Akses Notifikasi</string>
    <string name="onboarding_status_granted">Akses notifikasi telah diberikan. ActionBox sedang menangkap notifikasi.</string>
    <string name="onboarding_status_not_granted">Akses notifikasi belum diberikan.</string>

    <string name="feed_title">Notifikasi Tertangkap</string>
    <string name="feed_empty">Belum ada notifikasi yang ditangkap. Picu notifikasi dari aplikasi lain (WhatsApp, SMS, Gmail, dll.) untuk melihatnya muncul di sini.</string>

