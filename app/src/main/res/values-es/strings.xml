    <string name="app_name">ActionBox</string>

    <string name="onboarding_title">Permite que ActionBox lea tus notificaciones</string>
    <string name="onboarding_body">ActionBox organiza las notificaciones entrantes (como mensajes de WhatsApp, SMS y correos) en elementos accionables. Para ello, necesita permiso para leer el contenido de las notificaciones.\n\nEl contenido de tus notificaciones permanece en este dispositivo y nunca se sube a ningún sitio; la clasificación se realiza completamente en el dispositivo. (El plan gratuito muestra anuncios, y las compras de Pro se realizan a través de Google Play; ninguno de los dos ve el contenido de tus notificaciones.) Puedes revocar el acceso a las notificaciones en cualquier momento desde los ajustes del sistema.</string>
    <string name="onboarding_grant_button">Abrir ajustes de acceso a notificaciones</string>
    <string name="onboarding_status_granted">El acceso a las notificaciones está concedido. ActionBox está capturando notificaciones.</string>
    <string name="onboarding_status_not_granted">Aún no se ha concedido el acceso a las notificaciones.</string>

    <string name="feed_title">Notificaciones capturadas</string>
    <string name="feed_empty">Aún no se ha capturado ninguna notificación. Genera una notificación desde otra app (WhatsApp, SMS, Gmail, etc.) para verla aparecer aquí.</string>

